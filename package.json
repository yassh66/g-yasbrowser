{
  "name": "yas-browser",
  "version": "1.0.0",
  "description": "A modern, high-performance dark-themed desktop browser foundation with an integrated media downloader for YouTube and Instagram.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "start": "electron .",
    "start:dev": "vite --port=3000 --host=0.0.0.0 & electron ."
  },
  "keywords": [
    "electron",
    "browser",
    "media-downloader",
    "youtube-downloader",
    "instagram-downloader",
    "yt-dlp",
    "dark-theme"
  ],
  "author": "YAS Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.yas.browser",
    "productName": "YAS Browser",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles/**/*",
      "renderer/**/*",
      "assets/**/*",
      "public/**/*",
      "package.json",
      "!resources/**/*",
      "!dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/yas-browser.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/yas-browser.ico",
      "uninstallerIcon": "assets/yas-browser.ico"
    }
  }
}
